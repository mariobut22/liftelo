const express = require('express');
const router = express.Router();
const db = require('../db');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const generatePdfForIntervention = require('../utils/intervention-pdf');

const upload = multer({ dest: 'uploads/' });

function generateRandomNumber() {
  return Math.floor(1000 + Math.random() * 9000);
}

function formatFilename(location, date) {
  const initials = location
    .split(' ')
    .map(w => w[0].toLowerCase())
    .join('');

  const [year, month, day] = date.split('-');
  const random = generateRandomNumber();

  return `${initials}-i-${day}-${month}-${year}-${random}.pdf`;
}

// ✅ POST: Nova intervencija sa statusom
router.post('/', upload.array('files'), async (req, res) => {
  const { technician, second_technician, location, notes, date, status } = req.body;
  const files = req.files || [];

  const uploadedFilenames = files.map(file => file.originalname).join(', ');

  // Dohvati location_id prema imenu lokacije
  db.query('SELECT id FROM locations WHERE name = ?', [location], async (err, result) => {
    if (err || result.length === 0) {
      return res.status(400).json({ error: 'Lokacija nije pronađena' });
    }

    const location_id = result[0].id;

    const interventionData = {
      technician,
      second_technician,
      location,
      date,
      notes,
      uploadedFiles: files.map(f => f.originalname),
      status: status || 'NIJE RIJEŠENO' // ✅ fallback ako nije poslan
    };

    const filename = formatFilename(location, date);
    const pdfPath = path.join(__dirname, '..', 'pdfs', filename);

    try {
      await generatePdfForIntervention(interventionData, pdfPath);

      db.query(
        `INSERT INTO interventions 
          (technician, second_technician, location_id, date, notes, status, uploaded_files, pdf_path)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          technician,
          second_technician,
          location_id,
          date,
          notes,
          interventionData.status,
          uploadedFilenames,
          `/pdfs/${filename}`
        ],
        (err) => {
          if (err) {
            console.error(err);
            return res.status(500).json({ error: 'Greška pri spremanju intervencije' });
          }

          res.status(200).json({ message: 'Intervencija dodana i PDF kreiran' });
        }
      );
    } catch (error) {
      console.error('PDF error:', error);
      res.status(500).json({ error: 'Greška pri kreiranju PDF-a' });
    }
  });
});


// ✅ GET: Intervencije po lokaciji
router.get('/by-location/:id', (req, res) => {
  const locationId = req.params.id;
  db.query(
    'SELECT * FROM interventions WHERE location_id = ? ORDER BY date DESC',
    [locationId],
    (err, results) => {
      if (err) {
        return res.status(500).json({ error: 'Greška pri dohvaćanju intervencija' });
      }
      res.json(results);
    }
  );
});

module.exports = router;
