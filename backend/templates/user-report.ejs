<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8" />
  <title>Izvještaj korisnika</title>
  <style>
    body {
      font-family: 'Helvetica', sans-serif;
      margin: 40px;
      color: #333;
    }

    .header {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 2px solid #007bff;
      padding-bottom: 10px;
    }

    .logo {
      height: 60px;
      margin-right: 20px;
    }

    .title {
      font-size: 22px;
      color: #007bff;
    }

    .section {
      margin-top: 30px;
    }

    .section h3 {
      margin-bottom: 10px;
      color: #007bff;
      font-size: 18px;
    }

    .field {
      margin-bottom: 6px;
    }

    .label {
      font-weight: bold;
    }

    .value {
      margin-left: 5px;
    }

    .stats-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    .stats-table th,
    .stats-table td {
      border: 1px solid #ccc;
      padding: 8px;
      text-align: left;
    }

    .stats-table th {
      background-color: #f0f0f0;
    }

    .footer {
      margin-top: 40px;
      font-size: 12px;
      color: #999;
      text-align: center;
    }
  </style>
</head>
<body>

  <div class="header">
    <img src="<%= logoPath %>" alt="Logo" class="logo" />
    <div class="title">📄 Izvještaj korisnika</div>
  </div>

  <div class="section">
    <h3>👤 Osnovne informacije</h3>
    <div class="field"><span class="label">Korisničko ime:</span><span class="value"><%= user.username %></span></div>
    <div class="field"><span class="label">Ime i prezime:</span><span class="value"><%= user.full_name %></span></div>
    <div class="field"><span class="label">Uloga:</span><span class="value"><%= user.role %></span></div>
  </div>

  <div class="section">
    <h3>📊 Statistika rada</h3>
    <table class="stats-table">
      <tr>
        <th>Period</th>
        <th>Broj RMS unosa</th>
        <th>Broj intervencija</th>
      </tr>
      <tr>
        <td>Posljednjih 7 dana</td>
        <td><%= stats.last7Days.rms %></td>
        <td><%= stats.last7Days.interventions %></td>
      </tr>
      <tr>
        <td>Ovaj mjesec</td>
        <td><%= stats.thisMonth.rms %></td>
        <td><%= stats.thisMonth.interventions %></td>
      </tr>
      <tr>
        <td>Ukupno</td>
        <td><%= stats.total.rms %></td>
        <td><%= stats.total.interventions %></td>
      </tr>
    </table>
  </div>

  <div class="footer">
    Rijeka Dizala d.o.o. | Generirano automatski putem Liftelo sustava
  </div>

</body>
</html>
